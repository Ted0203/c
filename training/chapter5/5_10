#include <iostream>
using namespace std;

int main() {
    
    int a=0, e=0, i=0, o=0, u=0;
    char x;
    while(cin>>x)
    {
        switch(x)
        {
            case 'a':
            case 'A':
                a++;
                break;
            case 'e':
            case 'E':
                e++;
                break;
            case 'i':
            case 'I':
                i++;
                break;
            case 'o':
            case 'O':
                o++;
                break;
            case 'u':
            case 'U':
                u++;
                break;
        }
    }
    
    cout<<"a: "<<a<<endl
        <<"e: "<<e<<endl
        <<"i: "<<i<<endl
        <<"o: "<<o<<endl
        <<"u: "<<u<<endl;

    return 0;
}
