#include <iostream>
#include <vector>
using namespace std;

bool isPrefix(vector<int> &v1, vector<int> &v2)
{
    if(v1.size()>v2.size())
        return false;
    for(int i=0;i<v1.size();i++)
    {
        if(v1[i]!=v2[i])
            return false;
    }
    return true;
}

int main()
{
    vector<int> v1={0,1,1,2}, v2={0,1,1,2,3,5,8};
    
    if(isPrefix(v1,v2))
        cout<<"true"<<endl;
    else
        cout<<"false"<<endl;
    

    return 0;
}
