#include <iostream>
#include <string>
#include <vector>
using namespace std;

int main()
{
    vector<string>score={"F","D","C","B","A","A++"};
    int grade;
    string a;
    
    cin>>grade;
    if(grade<60)
        a=score[0];
    else
        a=score[(grade-50)/10];
    cout<<a;

    return 0;
}

//output:
100
A++
