#include <iostream>
#include <string>
using namespace std;

int main()
{
    string a, b;
    cin>>a>>b;
    if(a==b)
        cout<<"they are equal.";
    else if(a>b)
            cout<<"first is greater than last.";
        else
            cout<<"last is greater than first.";

    return 0;
}

