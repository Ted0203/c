#include <iostream>                  //array
using namespace std;

int main()
{
    int a[3], b[3];
    
    for(int i=0;i<3;i++)
        cin>>a[i];
    for(int i=0;i<3;i++)
        cin>>b[i];
    for(int i=0;i<3;i++)
    {
        if(a[i]!=b[i])
        {
            cout<<"a array is not equal to b array.";
            break;
        }
        if(i==2)
            cout<<"a array is equal to b array.";
    }

    return 0;
}

//output:
1
1
1
1
1
1
a array is equal to b array.

#include <iostream>                //vector
#include <vector>
using namespace std;

int main()
{
    vector<int> v1;
    vector<int> v2;
    
    int a;
    for(int i=0;i<3;i++)
    {
        cin>>a;
        v1.push_back(a);
    }
    for(int i=0;i<3;i++)
    {
        cin>>a;
        v2.push_back(a);
    }
    
    if(v1!=v2)
        cout<<"v1 is not equal to v2.";
    else
        cout<<"v1 is equal to v2.";

    return 0;
}

