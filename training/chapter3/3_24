#include <iostream>
#include <string>
#include <vector>
using namespace std;

int main()
{
    vector<int> v1;
    int i;
    while(cin>>i)
        v1.push_back(i);
    
    for(auto a=v1.begin();a!=v1.end()-1;a++)
        cout<<*a+*(a+1)<<" ";

    return 0;
}

//input:  12 22 42
//output: 34 64


#include <iostream>
#include <string>
#include <vector>
using namespace std;

int main()
{
    vector<int> v1;
    int i;
    while(cin>>i)
        v1.push_back(i);
    
    auto mid=v1.begin()+(v1.end()-v1.begin())/2;
    for(auto a=v1.begin();a!=mid;a++)
        cout<<*a+*(v1.end()-1-(a-v1.begin()))<<" ";         //(a-v1.begin())代表距離a位移量

    return 0;
}

//iuput:  12 22 34 52
//output: 64 56 
